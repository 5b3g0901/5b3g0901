<Window x:Class="_5b3g0901.MyDocumentViewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="MyDocumentViewer" Height="450" Width="800">
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar x:Name="EditingToolBar">
                <Button Command="ApplicationCommands.Cut" Content="✂️剪下" ToolTip="剪下" />
                <Button Command="ApplicationCommands.Copy" Content="📄複製" ToolTip="複製" />
                <Button Command="ApplicationCommands.Paste" Content="📋貼上" ToolTip="貼上" />
                <Separator />
                <ToggleButton Command="EditingCommands.ToggleBold" Content="B" FontWeight="Bold" ToolTip="加粗" />
                <ToggleButton Command="EditingCommands.ToggleItalic" Content="I" FontStyle="Italic" ToolTip="斜體" />
                <ToggleButton Command="EditingCommands.ToggleUnderline" Content="U" ToolTip="底線" />
                <Separator />
                <xctk:ColorPicker x:Name="TextColorPicker" Width="50" SelectedColorChanged="TextColorPicker_SelectedColorChanged" ToolTip="字體顏色"/>
                <Separator />
                <ComboBox x:Name="FontFamilyComboBox" Width="120" SelectionChanged="FontFamilyComboBox_SelectionChanged" ToolTip="字型"/>
                <ComboBox x:Name="FontSizeComboBox" Width="50" SelectionChanged="FontSizeComboBox_SelectionChanged" ToolTip="字體大小"/>
            </ToolBar>
        </ToolBarTray>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="就緒" />
            </StatusBarItem>
        </StatusBar>
        <RichTextBox x:Name="MyRichTextBox" AcceptsReturn="True" SpellCheck.IsEnabled="True" />
    </DockPanel>
</Window>